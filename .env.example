# OpenRouter API key (required) — code loads OPENROUTER_SECRET_KEY via llm_client / run scripts
OPENROUTER_SECRET_KEY=your_openrouter_api_key_here

# MongoDB (typical for logging runs and traces)
# Format: mongodb://[username:password@]host[:port]/[database]
MONGODB_URI=mongodb://localhost:27017/causalflow

