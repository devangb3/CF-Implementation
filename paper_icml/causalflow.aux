\@LN@col{2}
\newlabel{tab:accuracy}{{2}{6}{Baseline agent accuracy vs accuracy after inference-time counterfactual repair using CausalFlow. Post-repair accuracy reflects applying graph-consistent causal intervention to failed traces without modifying model parameters. Structured step-level repair yields consistent improvements across domains.\relax }{table.caption.3}{}}
\newlabel{tab:accuracy@cref}{{[table][2][]2}{[1][6][]6}}
\newlabel{fig:results}{{2}{7}{\textbf {Left:} Repair rate across benchmarks, measured as the percentage of failed execution traces converted to successful outcomes via graph-consistent counterfactual intervention. \textbf {Right:} Baseline versus deploy-time post-repair accuracy after applying \textsc {CausalFlow} without parameter updates. Improvements across all domains indicate that a substantial fraction of agent errors are attributable to localized, causally responsible steps.\relax }{figure.caption.4}{}}
\newlabel{fig:results@cref}{{[figure][2][]2}{[1][6][]7}}
